BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName", "Alan Becker Fan Recreation"
            VALUE "FileDescription", "desktop-stickman Desktop Overlay v4"
            VALUE "FileVersion", "4.0.0"
            VALUE "InternalName", "desktop-stickman"
            VALUE "OriginalFilename", "desktop-stickman.exe"
            VALUE "ProductName", "Alan Becker Desktop Stickmen"
            VALUE "ProductVersion", "4.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
